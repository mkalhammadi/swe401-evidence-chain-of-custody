digraph UC {
  rankdir=LR; dpi=170; nodesep=0.22; ranksep=0.9; splines=true;
  node [fontname="Arial", fontsize=12];
  edge [color="#1f3b5c", arrowsize=0.7, fontname="Arial", fontsize=10];
  node [shape=none, image="actor.png", labelloc=b, height=1.3, width=0.7, imagepos=tc, fixedsize=false];
  Investigator [label="Investigator"]; Supervisor [label="Supervisor"];
  Auditor [label="Auditor"]; Administrator [label="Administrator"]; Scheduler [label="Scheduler (timer)"];
  node [shape=ellipse, image="", style=filled, fillcolor="#eef3f9", color="#1f3b5c", height=0.45, width=2.9, fixedsize=true, labelloc=c];
  subgraph cluster_sys {
    label=<<b>Digital Evidence Chain-of-Custody System</b>>; fontname="Arial"; fontsize=14; color="#1f3b5c"; style=rounded;
    UC1 [label="UC-01 Log in / Log out"];
    UC2 [label="UC-02 Create case"];
    UC3 [label="UC-03 Close case"];
    UC4 [label="UC-04 Upload evidence"];
    UC5 [label="UC-05 View / Download evidence"];
    UC6 [label="UC-06 Request custody transfer"];
    UC7 [label="UC-07 Accept / Reject transfer"];
    UC8 [label="UC-08 Verify evidence integrity"];
    UC9 [label="UC-09 Scheduled integrity check"];
    UC10 [label="UC-10 View custody history"];
    UC11 [label="UC-11 Verify audit chain"];
    UC12 [label="UC-12 Export PDF custody report"];
    UC13 [label="UC-13 Review / acknowledge alerts"];
    UC14 [label="UC-14 Manage users and roles"];
    H [label="Generate SHA-256 hash", fillcolor="#fdf6ec"];
    REC [label="Record custody event", fillcolor="#fdf6ec"];
    AL [label="Raise anomaly alert", fillcolor="#fdf6ec"];
  }
  edge [arrowhead=none];
  Investigator -> {UC1 UC2 UC4 UC5 UC6 UC7 UC8 UC10 UC12};
  Supervisor -> {UC1 UC2 UC3 UC7 UC10 UC12 UC13};
  // right-side actors: edges drawn from use case to actor
  {UC1 UC8 UC10 UC11 UC12 UC13} -> Auditor;
  {UC1 UC14} -> Administrator;
  UC9 -> Scheduler;
  edge [style=dashed, arrowhead=vee, arrowsize=0.8, fontcolor="#1f3b5c"];
  UC4 -> H [label="«include»", constraint=false];
  UC4 -> REC [label="«include»", constraint=false];
  UC5 -> REC [label="«include»", constraint=false];
  UC7 -> REC [label="«include»", constraint=false];
  UC9 -> UC8 [label="«include»", constraint=false];
  AL -> UC8 [label="«extend»\n[hash mismatch]", constraint=false];
  AL -> UC5 [label="«extend»\n[after hours / bulk]", constraint=false];
  Investigator -> H [style=invis]; Investigator -> REC [style=invis]; Supervisor -> AL [style=invis];
}
