@startuml
!include style.iuml
left to right direction
skinparam packageStyle rectangle
actor Investigator as I
actor Supervisor as S
actor Auditor as A
actor Administrator as AD
actor "Scheduler\n(timer)" as T
rectangle "Digital Evidence Chain-of-Custody System" {
  usecase "UC-01 Log in / Log out" as UC1
  usecase "UC-02 Create case" as UC2
  usecase "UC-03 Close case" as UC3
  usecase "UC-04 Upload evidence" as UC4
  usecase "Generate SHA-256 hash" as H
  usecase "UC-05 View / Download evidence" as UC5
  usecase "UC-06 Request custody transfer" as UC6
  usecase "UC-07 Accept / Reject transfer" as UC7
  usecase "UC-08 Verify evidence integrity" as UC8
  usecase "UC-09 Scheduled integrity check" as UC9
  usecase "UC-10 View custody history / audit log" as UC10
  usecase "UC-11 Verify audit chain" as UC11
  usecase "UC-12 Export PDF custody report" as UC12
  usecase "UC-13 Review / acknowledge alerts" as UC13
  usecase "UC-14 Manage users and roles" as UC14
  usecase "Record custody event\n(hash-chained)" as REC
  usecase "Raise anomaly alert" as AL
}
I --> UC1
I --> UC2
I --> UC4
I --> UC5
I --> UC6
I --> UC7
I --> UC8
I --> UC10
I --> UC12
S --> UC2
S --> UC3
S --> UC7
S --> UC13
UC10 <-- A
UC11 <-- A
UC12 <-- A
UC13 <-- A
UC8 <-- A
UC14 <-- AD
UC1 <-- AD
UC9 <-- T
UC4 ..> H : <<include>>
UC4 ..> REC : <<include>>
UC5 ..> REC : <<include>>
UC7 ..> REC : <<include>>
UC9 ..> UC8 : <<include>>
AL ..> UC8 : <<extend>>\n[hash mismatch]
AL ..> UC5 : <<extend>>\n[after hours / bulk]
note "Every actor can log in (UC-01),\nview history (UC-10) and export\nreports (UC-12) within their role." as N1
@enduml
